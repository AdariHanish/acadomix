# =============================================
# ACADOMIX — .gitignore
# =============================================

# --- Dependencies ---
node_modules/
.pnp
.pnp.js

# --- Build Output ---
dist/
build/
.output/

# =============================================
# SECRETS & SENSITIVE CONFIG — NEVER PUSH THESE
# =============================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.*.local
*.pem
*.key
*.cert
serviceAccountKey.json
firebase-adminsdk*.json

# --- IDE & Editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS generated files ---
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini
ehthumbs.db
Icon?

# --- Debug & Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
*.log

# --- Netlify ---
.netlify/

# --- Vercel ---
.vercel/

# --- TypeScript cache ---
*.tsbuildinfo
next-env.d.ts

# --- Temporary helper / one-off scripts ---
*.pyc
__pycache__/
setup_db.py
update_reviews.py
*.sh

# --- Test & Coverage ---
coverage/
.nyc_output/

# --- Misc ---
*.zip
*.tar.gz
*.bak
*.tmp